# Copy to .env.local for local development. Both are optional: without them
# Claro runs exactly as it did before sync existed, entirely on the device.
#
# These end up in a public bundle, which is how Supabase anon keys work. The
# security boundary is row-level security in supabase/schema.sql, not secrecy.
# Never put a service_role key in either of these.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed to run `npm run db:push`, which applies supabase/migrations to
# your project. Supabase dashboard -> Project Settings -> Database ->
# Connection string -> URI. Quote it: passwords often contain characters the
# shell would otherwise read.
#
# This is the narrowest credential that can do the job, scoped to one database.
# A personal access token would grant management access to your whole Supabase
# account, so prefer this.
SUPABASE_DB_URL=
